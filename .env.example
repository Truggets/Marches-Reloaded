# Marches Reload — environment variable template.
# Copy to `.env` on the server and fill in real values. NEVER commit the real .env.
# Secrets live ONLY in environment variables on the VPS — never in a git-tracked file,
# never pasted into chat/sandbox (matches the therink-dashboard convention).

# --- Server ---
PORT=3001
NODE_ENV=production

# Session signing secret — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# SQLite database file path (on the server)
DATABASE_PATH=./data/marches.sqlite

# Registration gate — the invite code friends need to create an account
INVITE_CODE=

# First admin/DM bootstrap (used once on first run to seed the admin account)
ADMIN_USERNAME=
ADMIN_PASSWORD=
