# Marches Reload — environment variable template.
# Copy to `.env` on the server and fill in real values. NEVER commit the real .env.
# Secrets live ONLY in environment variables on the VPS — never in a git-tracked file,
# never pasted into chat/sandbox (matches the therink-dashboard convention).

# --- Server ---
PORT=3001
NODE_ENV=production

# Session signing secret — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Database path is NOT configurable via env — it's computed in code
# (server/src/config.js) as an absolute path under `shared/data/marches.sqlite`,
# mirroring the sibling therink-dashboard app. This keeps the DB on the one
# writable/persistent path allowed by the hardened systemd unit
# (ReadWritePaths=/opt/marches-reload/shared) rather than the ephemeral
# `current/` release directory.

# Registration gate — the invite code friends need to create an account
INVITE_CODE=

# First admin/DM bootstrap (used once on first run to seed the admin account)
ADMIN_USERNAME=
ADMIN_PASSWORD=
