# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/
server/dist/

# Secrets & environment — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# Database & backups (runtime data lives on the server, not in git)
*.sqlite
*.sqlite3
*.db
data/*.sqlite
backups/

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Non-SRD content-pack import output (never bundled/shipped — see CLAUDE.md
# SRD-only constraint). The fixtures themselves are small representative
# samples and stay tracked; only parser *output* written under this dir is
# ignored.
data/build/fixtures/*-output.json
