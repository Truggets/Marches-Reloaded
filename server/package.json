{
  "name": "marches-reload-server",
  "version": "0.1.0",
  "private": true,
  "description": "Marches Reload API — thin Node/Express JSON server (auth, character CRUD, admin). No game-rules logic lives here.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "argon2": "^0.45.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-session": "^1.19.0"
  },
  "allowScripts": {
    "argon2@0.45.0": true,
    "better-sqlite3@12.11.1": true
  }
}
