[Unit]
Description=Marches Reload
After=network.target

[Service]
Type=simple
User=marches
Group=marches
WorkingDirectory=/opt/marches-reload/current/server
Environment=APP_ROOT=/opt/marches-reload
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/marches-reload/shared

[Install]
WantedBy=multi-user.target
